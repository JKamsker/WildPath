<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net48;netstandard2.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageIcon>logo-transparent-128x128.png</PackageIcon>
		<WarnAsError>true</WarnAsError>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSourceGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!-- Basic metadata -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>WildPath</PackageId>
		<Version>0.0.7</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Authors>Jonas Kamsker</Authors>
		<Company>JKamsker</Company>
		<Product>WildPath</Product>
		<Description>WildPath is a library for advanced file-system path resolution, with pattern matching and dynamic traversal capabilities.</Description>
		<PackageTags>wildcard path filesystem traversal glob globbing</PackageTags>
		<RepositoryUrl>https://github.com/JKamsker/WildPath</RepositoryUrl>

		<!-- Optional additional metadata -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/JKamsker/WildPath</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Jonas Kamsker © 2024</Copyright>
		
	</PropertyGroup>


	<PropertyGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'  Or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Memory" Version="4.6.0" />

		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\resources\logo-transparent-128x128.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="buildTransitive\WildPath.props">
	    <Pack>True</Pack>
	    <PackagePath>buildTransitive\WildPath.props</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Strategies\Custom\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\WildPath.SourceGenerator\WildPath.SourceGenerator.csproj"
	                    ReferenceOutputAssembly="false"
	                    OutputItemType="Analyzer"
	                    PrivateAssets="all" />
	</ItemGroup>

	<Target Name="PackSourceGenerator" Condition="'$(TargetFramework)' == 'netstandard2.0'">
	  <MSBuild Projects="..\WildPath.SourceGenerator\WildPath.SourceGenerator.csproj"
	           Targets="Build"
	           Properties="Configuration=$(Configuration)"
	           Condition="'$(NoBuild)' != 'true'" />
	  <ItemGroup>
	    <TfmSpecificPackageFile Include="..\WildPath.SourceGenerator\bin\$(Configuration)\netstandard2.0\WildPath.SourceGenerator.dll"
	                            PackagePath="analyzers\dotnet\cs"
	                            Condition="Exists('..\WildPath.SourceGenerator\bin\$(Configuration)\netstandard2.0\WildPath.SourceGenerator.dll')" />
	  </ItemGroup>
	</Target>

</Project>
